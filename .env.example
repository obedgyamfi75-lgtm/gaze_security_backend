# =============================================================================
# GAZE Security Platform - Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# Generate secrets: openssl rand -hex 32
# =============================================================================

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Database (PostgreSQL)
DB_USER=secops
DB_PASS=CHANGE_ME_generate_secure_password
DB_NAME=secops
DATABASE_URL=postgresql://${DB_USER}:${DB_PASS}@postgres:5432/${DB_NAME}

# Redis (Sessions & Rate Limiting)
REDIS_PASS=CHANGE_ME_generate_secure_password
REDIS_URL=redis://:${REDIS_PASS}@redis:6379/0

# CORS - Frontend Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Security
ALLOWED_HOSTS=localhost
LOG_LEVEL=INFO

# Domain (for Caddy TLS - production only)
# DOMAIN=secops.hubtel.com

# =============================================================================
# Quick Setup Commands:
# =============================================================================
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Generate secrets (run each and paste into .env):
#    openssl rand -hex 32  # For SECRET_KEY
#    openssl rand -hex 16  # For DB_PASS
#    openssl rand -hex 16  # For REDIS_PASS
#
# 3. Start services:
#    docker compose up -d
#
# 4. Initialize database:
#    docker compose exec app flask db upgrade
#    docker compose exec app flask seed-admin
# =============================================================================
